# ---- LLM (optional: without a key the app runs in clearly-labelled DEMO MODE) ----
GEMINI_API_KEY=
P2P_LLM_PROVIDER=auto            # auto | gemini | demo
P2P_LLM_MODEL=gemini-3.8-flash
P2P_LLM_PRICE_PER_1K=0           # optional USD per 1k tokens for cost estimates
P2P_LLM_TIMEOUT_S=120            # per-request timeout
P2P_LLM_MAX_RETRIES=1            # bounded retries for 429/5xx/network errors
# ---- GitHub (optional; read-only inspection works without; export needs a fine-scoped token) ----
GITHUB_TOKEN=
# ---- Hugging Face (optional, for gated datasets) ----
HF_TOKEN=
# ---- Platform ----
P2P_SANDBOX=auto                 # auto | docker | local
P2P_SANDBOX_IMAGE=paper2product-sandbox:1
P2P_DATA_DIR=./data
P2P_API_KEY=                     # if set, every /api request needs header X-API-Key
P2P_MAX_UPLOAD_MB=20
P2P_RATE_LIMIT_PER_MIN=60
